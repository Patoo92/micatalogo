# =============================================
#  VARIABLES DE ENTORNO — micatalogo
# =============================================
# Copia este archivo a `.env` y completá los valores.
# `.env` NO se sube al repositorio (está en .gitignore)
# y el webroot lo bloquea via .htaccess.
#
# En producción, preferí definir estas variables en el
# entorno real del servidor (panel del hosting, systemd,
# Docker) en vez del .env — el entorno real siempre gana.
# =============================================

# ---- Base de datos ----
DB_HOST=localhost
DB_NAME=catalogo_whatsapp
DB_USER=root
DB_PASS=
DB_CHARSET=utf8mb4

# ---- SMTP (Brevo / cualquier proveedor) ----
SMTP_HOST=smtp-relay.brevo.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
SMTP_FROM_NAME=micatalogo

# ---- Stripe ----
# Keys del modo test: sk_test_... / pk_test_...
# En producción: sk_live_... / pk_live_...
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
# Signing secret del webhook (Stripe Dashboard → Webhooks)
STRIPE_WEBHOOK_SECRET=
# true = modo test, false = producción
STRIPE_TEST_MODE=true
# Price IDs (Stripe Dashboard → Productos). Mismo formato para _ANUAL.
STRIPE_PRICE_PRO_MENSUAL=
STRIPE_PRICE_PRO_ANUAL=
STRIPE_PRICE_BUSINESS_MENSUAL=
STRIPE_PRICE_BUSINESS_ANUAL=
STRIPE_PRICE_ENTERPRISE_MENSUAL=
STRIPE_PRICE_ENTERPRISE_ANUAL=

# ---- Varios ----
# Ruta al binario mysqldump (para respaldos). Vacío = usar el de PATH.
MYSQLDUMP_PATH=
# CDN opcional para imágenes (ej: https://cdn.tudominio.com)
CDN_URL=
